# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-access-token
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Anthropic (Claude API — required for Fastify app runtime)
ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-key

# VPS API
API_BASE_URL=https://your-vps.example.com
API_BEARER_TOKEN=your-shared-secret

# Salesforce / Trailhead
# Use custom domain login URL (not login.salesforce.com) if your org has a custom domain
SALESFORCE_USERNAME=your-agentforce-username@domain.com
SALESFORCE_PASSWORD=your-password
SALESFORCE_SECURITY_TOKEN=your-security-token
SALESFORCE_LOGIN_URL=https://your-org.develop.lightning.force.com

# Playwright
PLAYWRIGHT_HEADLESS=true

# App
NODE_ENV=development
PORT=3001
