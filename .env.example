# Supabase
# SUPABASE_URL is used by the Fastify API (server-side, no NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-access-token
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Anthropic (Claude API — required for Fastify app runtime)
ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-key

# VPS API
# Fastify API uses API_BEARER_TOKEN
API_BEARER_TOKEN=your-shared-secret-min-32-chars
# Next.js frontend (server-only vars — never NEXT_PUBLIC_)
VPS_API_URL=http://localhost:3001
VPS_API_SECRET=your-shared-secret-min-32-chars

# Salesforce / Trailhead
# Use custom domain login URL (not login.salesforce.com) if your org has a custom domain
SALESFORCE_USERNAME=your-agentforce-username@domain.com
SALESFORCE_PASSWORD=your-password
SALESFORCE_SECURITY_TOKEN=your-security-token
SALESFORCE_LOGIN_URL=https://your-org.develop.lightning.force.com

# Playwright
PLAYWRIGHT_HEADLESS=true

# App
NODE_ENV=development
PORT=3001
